#version 460 core

// Merge 3 r32ui intermediates into rgba16f. R==0 means the voxel was not
// written this frame — the clear pass has already zeroed rgba16f for us.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(binding = 0) uniform usampler3D SamplerVoxelsR;
layout(binding = 1) uniform usampler3D SamplerVoxelsG;
layout(binding = 2) uniform usampler3D SamplerVoxelsB;

layout(binding = 0, rgba16f) restrict writeonly uniform image3D ImgResult;

void main()
{
    ivec3 coord = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(coord, imageSize(ImgResult))))
        return;

    uint rBits = texelFetch(SamplerVoxelsR, coord, 0).r;
    if (rBits == 0u)
        return;

    float r = uintBitsToFloat(rBits);
    float g = uintBitsToFloat(texelFetch(SamplerVoxelsG, coord, 0).r);
    float b = uintBitsToFloat(texelFetch(SamplerVoxelsB, coord, 0).r);

    imageStore(ImgResult, coord, vec4(r, g, b, 1.0));
}
